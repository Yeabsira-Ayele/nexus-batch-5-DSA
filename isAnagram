class Solution(object):
    def isAnagram(self, s, t):
        if len(s) != len(t):
            return False
        s = sorted(s)
        t = sorted(t)
        i = 0
        while i < len(s):
            if s[i] == t[i]:
                i += 1
                continue
            else:
                return False
        return True

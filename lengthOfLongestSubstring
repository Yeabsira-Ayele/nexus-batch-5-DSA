class Solution(object):
    def lengthOfLongestSubstring(self, s):
        l = 0
        r = 0
        set1 = []
        largest = 0
        while r < len(s):
            if s[r] not in set1:
                set1.append(s[r])
                r += 1
            else:
                set1.pop(0)
                l +=1
            if r - l  > largest:
                largest = r - l 
        return largest

        

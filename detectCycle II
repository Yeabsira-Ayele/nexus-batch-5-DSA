class Solution(object):
    def detectCycle(self, head):
        flag = False
        slow = head 
        fast =  head

        while fast and fast.next:
            fast = fast.next.next
            slow = slow.next

            if fast == slow:
                flag = True
                break
        if flag == True:
            s = head
           
            while   s != fast:
                s = s.next
                fast = fast.next
            return s
        else:
            return None

              

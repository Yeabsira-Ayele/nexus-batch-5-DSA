class Solution(object):
    def matchPlayersAndTrainers(self, players, trainers):
        players.sort()
        trainers.sort()
        i = 0
    
        count = 0
       
        for player in players:
            j = i
            while j < len(trainers):
                if player <= trainers[j]:
                    count +=1
                    i = j + 1
                    break
                j +=1
            if j == len(trainers):
                 return count

        return count
                

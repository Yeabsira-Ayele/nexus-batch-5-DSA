class Solution(object):
    def reverseVowels(self, s):
        vowels = ["a" , "e" , "i" , "o" , "u" , "A" , "E" , "I" , "O" , "U"]
        left = 0
        s = list(s)
        right = len(s) - 1
        while left < right:
            if s[left]  not in vowels:
                left += 1
            elif s[right] not in vowels:
                right -=1
            elif s[right]  in vowels and  s[left]  in vowels:
                s[left] , s[right] = s[right] , s[left]
                left += 1
                right -= 1
        return "".join(s)

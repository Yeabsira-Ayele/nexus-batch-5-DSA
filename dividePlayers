class Solution(object):
    def dividePlayers(self, skill):
        skill.sort()
        sum_ = 0
        i = 0
        j = len(skill) - 1
        prev_sum = skill[i] + skill[j]
    
        while i < j:
    
            if skill[i] + skill[j] != prev_sum:
                return -1
            else:
                sum_ += (skill[i] * skill[j] ) 
            i += 1
            j -= 1
        return sum_
            

        

class Solution(object):
    def countDigits(self, num):
        lst = []
        n = num
        while n:
            lst.append(n%10)
            n = n // 10
        i = 0
        count = 0
        while i < len(lst):
            if num % lst[i] == 0:
                count +=1
            i +=1
        return count
        

import math
class Solution(object):
    def judgeSquareSum(self, c):
        left = 0
        right = math.floor(math.sqrt(c)) 
        while left <= right:
            ans = left * left + right * right
            if ans == c:
                return True
            elif ans <= c:
                left += 1
            else:
                right -= 1
            

        return False
